import { ScrollView } from "std-widgets.slint";
import "./fonts/Play-Regular.ttf";
import "./fonts/Play-Bold.ttf";

export struct ServerCardItem {
    id: string,
    name: string,
    software: string,
    version: string,
    port: string,
    ram: string,
    status: string,
    is-running: bool,
}

export struct FileItem {
    name: string,
    is-dir: bool,
    size: string,
}

export struct PlayerItem {
    name: string,
    uuid: string,
    is-op: bool,
    is-whitelisted: bool,
}

export struct WorldItem {
    name: string,
    kind: string,
    exists: bool,
}

export struct BackupItem {
    name: string,
    size: string,
}

export struct ModItem {
    title: string,
    description: string,
    downloads: string,
    slug: string,
    installed: bool,
    has-icon: bool,
    icon: image,
}

export struct VersionRow {
    v1: string, has1: bool,
    v2: string, has2: bool,
    v3: string, has3: bool,
    v4: string, has4: bool,
}

export global AppTheme {
    in-out property <bool> is-dark: true;
    out property <bool> light: !is-dark;

    // Chrome never inverts — Aternos header + sidebar stay dark grey.
    out property <color> header: #2D3943;
    out property <color> sidebar: #2D3943;
    out property <color> chrome: #f0f0f0;
    out property <color> nav-active: #40505c;
    out property <color> nav-hover: #47535D;

    out property <color> page: is-dark ? #161c21 : #F0F0F0;
    out property <color> card: #2D3943;
    out property <color> inset: #40505c;
    // Page titles follow theme. Text sitting on dark cards/insets stays light.
    out property <color> text: is-dark ? #f0f0f0 : #2D3943;
    out property <color> muted: is-dark ? #A4A4A4 : #47535D;
    out property <color> on-card: #f0f0f0;
    out property <color> on-card-muted: #A4A4A4;
    out property <color> line: #40505c;
    out property <length> line-w: 0px;

    out property <color> nav: #f0f0f0;

    out property <color> btn: is-dark ? #2b87d3 : #d0d0d0;
    out property <color> btn-hover: is-dark ? #277cc2 : #c2c2c2;
    out property <color> btn-press: is-dark ? #277cc2 : #2b87d3;
    out property <color> btn-text: is-dark ? #f0f0f0 : #2D3943;
    out property <color> btn-dark: is-dark ? #40505c : #d0d0d0;
    out property <color> btn-dark-hover: is-dark ? #47535D : #c2c2c2;
    out property <color> btn-dark-press: is-dark ? #47535D : #40505c;
    out property <color> btn-frame: is-dark ? #2b87d3 : #b5b5b5;
    out property <length> btn-frame-w: is-dark ? 0px : 1px;
}

// --- ATERNOS-STYLE CONTROLS ---

component AtInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "";
    callback accepted;

    height: 40px;
    vertical-stretch: 0;
    border-radius: 2px;
    clip: true;
    background: AppTheme.inset;
    border-width: AppTheme.line-w;
    border-color: AppTheme.line;
    forward-focus: input;

    // Behind the TextInput. Must set x/y or Slint stacks this below the field
    // (typed text "falls" out of view and the placeholder never hides).
    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 100%;
        overflow: clip;
        horizontal-alignment: left;
        vertical-alignment: center;
        visible: input.text == "" && input.preedit-text == "";
        text: root.placeholder-text;
        color: AppTheme.on-card-muted;
        font-size: 14px;
        font-family: "Play";
        accessible-role: none;
    }

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 100%;
        single-line: true;
        horizontal-alignment: left;
        vertical-alignment: center;
        color: AppTheme.on-card;
        font-size: 14px;
        font-family: "Play";
        accepted => { root.accepted(); }
    }
}

